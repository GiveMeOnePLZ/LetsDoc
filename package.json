{
  "name": "letsdoc",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "electron:dev": "node electron/dev.cjs",
    "electron:build": "npm run build && electron-builder --mac"
  },
  "build": {
    "appId": "com.docxgen.app",
    "productName": "LetsDoc 文书模板生成器",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*.cjs"
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.productivity"
    }
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.5",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "antd": "^6.4.4",
    "docxtemplater": "^3.68.7",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "pizzip": "^3.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.2",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^35.5.1",
    "electron-builder": "^26.0.12",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
